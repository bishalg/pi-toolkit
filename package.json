{
  "name": "pi-toolkit",
  "version": "0.1.0",
  "description": "Organization-wide Pi agent extensions, skills, and workflow templates.",
  "author": "Bishal Ghimire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bishalg/pi-toolkit.git"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skills",
    "antigravity",
    "nx",
    "expo",
    "tanstack",
    "vite",
    "sdd",
    "spec-kit"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.spec.ts",
    "model": "node --experimental-strip-types scripts/model-manager.ts",
    "lint": "eslint extensions/",
    "lint:fix": "eslint extensions/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "extensions/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "typebox": "^1.3.34",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
